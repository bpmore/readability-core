{
    "name": "bpmore/readability-core",
    "description": "Readability and plain-language analysis for English text: extraction, formulas, rules and findings. Framework-agnostic, so one engine can serve more than one product.",
    "keywords": [
        "readability",
        "plain-language",
        "flesch-kincaid",
        "smog",
        "gunning-fog",
        "coleman-liau"
    ],
    "license": "proprietary",
    "type": "library",
    "homepage": "https://hada.farm",
    "authors": [
        {
            "name": "Brent Passmore",
            "homepage": "https://hada.farm"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "pestphp/pest": "^3.8 || ^4.0"
    },
    "suggest": {
        "ext-intl": "Composes accented characters before they are counted, so an \"é\" typed as two code points is the same word as one typed as one."
    },
    "autoload": {
        "psr-4": {
            "Bpmore\\ReadabilityCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bpmore\\ReadabilityCore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
